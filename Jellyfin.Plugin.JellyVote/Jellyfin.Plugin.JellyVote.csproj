<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
        <AssemblyVersion>1.0.2.0</AssemblyVersion>
        <FileVersion>1.0.2.0</FileVersion>
    <RootNamespace>Jellyfin.Plugin.JellyVote</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.JellyVote</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Configuration\configPage.css" />
    <EmbeddedResource Include="Configuration\configPage.css" />
    <None Remove="Web\jellyvote.js" />
    <EmbeddedResource Include="Web\jellyvote.js" />
  </ItemGroup>

</Project>
